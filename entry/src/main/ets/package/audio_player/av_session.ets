////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////
// 导入第三方库 //
///////////////
import { common } from '@kit.AbilityKit'
import { avSession } from '@kit.AVSessionKit'

//////////////////
// 导入自创建模块 //
////////////////

///////////
// 变量池 //
//////////

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 类框架 //
//////////
export class av_session {

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  // 环境准备 //
  ////////////

  ///////////
  // 变量池 //
  //////////

  ////////
  // 类 //
  ///////
  private session: avSession.AVSession | null = null; // 元音频

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  // 内部函数 //
  ////////////

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  // 外部函数 //
  ////////////

  // 初始化 //
  async start_up() {
    // 创建AVSession
    this.session = await avSession.createAVSession(getContext(this), 'ArkMusic', 'audio')
    // 注册行为
  }

  // 设置标题 //
  set_title(id: number, title: string) { this.session?.setAVMetadata({ assetId: `${id}`, title: title }) }
  // 设置副标题(歌手)
  set_artist(id: number, artist: string) { this.session?.setAVMetadata({ assetId: `${id}`, artist: artist }) }
  // 设置封面 //

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  // 初始化 //
  //////////
  constructor() {}


}