//
// 版本号修复 / 更新
//

// 当前版本
const current_version = '70'

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 函数块 //
//////////

// 0.6升级0.7
function v60_70(): string {return '70'}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 主函数头 //
////////////
export function version_update(version: string = current_version) {
  while (true) {
    if (version === '60') {
      version = v60_70()
    }
    else {break}
  }
  return version
}