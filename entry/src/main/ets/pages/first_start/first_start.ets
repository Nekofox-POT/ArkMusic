// start界面
//
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// 导入页 //
import step_a from './step_a'
import step_b from './step_b'
import step_c from './step_c'

// 开始界面入口 //
///////////////
@Component
@Preview
export default struct first_start {

  ///////////
  // 继承池 //
  //////////
  @Link first_start: boolean    // 环境准备指示器
  @State page: number = 1

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  // 基础函数 //
  ////////////

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  // UI构建 //
  ///////////
  build() {
    Row() {

      /////////////////
      // 第一页：欢迎 //
      /////////////////
      if (this.page === 1) {
        step_a({
          page: this.page
        })
          .width('100%').height('100%')
      }

      ///////////////////
      // 第二页：教程 //
      ///////////////////
      if (this.page === 2) {
        step_b({
          page: this.page
        })
          .width('100%').height('100%')
      }

      /////////////////////
      // 第三页：开始使用 //
      /////////////////////
      if (this.page === 3) {
        step_c({
          first_start: $first_start
        })
          .width('100%').height('100%')
      }

    }
    .width('100%').height('100%')
    .clip(true)
  }
}
